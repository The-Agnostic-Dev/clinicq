{
  "name": "clinicq",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "Front desk system for a small private clinic: walk-in queue, appointments, doctor availability and daily summary.",
  "scripts": {
    "dev": "vite dev --port 5114",
    "build": "vite build",
    "preview": "vite preview --port 5114",
    "start": "node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.19.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
